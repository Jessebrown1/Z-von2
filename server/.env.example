# Paystack secret key — server-side only, never expose this to the browser.
# Get it from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The public key lives only in the project root .env as
# VITE_PAYSTACK_PUBLIC_KEY — the browser reads it directly. No need to
# duplicate it here.

# Must match the currency your Paystack account is actually configured to
# charge in. Product prices in src/data/products.js are GHS-native, so this
# should stay GHS unless you re-price the whole catalog in another currency.
PAYSTACK_CURRENCY=GHS

# Signs login session tokens — generate a random one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse a value that's been committed or shared anywhere.
JWT_SECRET=

# "Sign in with Google" — from Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID (Web application). Same value as the
# project root's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Whichever account has this email gets promoted to admin on every server
# boot, gaining access to /admin (order + product management).
ADMIN_EMAIL=

# --- Database (Turso — hosted, SQLite-compatible) ---
# Leave both blank for local dev: falls back to a local libSQL file at
# server/data/zevon.db automatically, no Turso account needed.
# For production, create a free database at https://turso.tech, then:
#   turso db create zevon
#   turso db show zevon --url          -> TURSO_DATABASE_URL
#   turso db tokens create zevon       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Image uploads (Cloudinary — free tier) ---
# From your Cloudinary dashboard (https://cloudinary.com) after signup.
# Admin product image uploads fail without these; everything else works fine.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Deployment ---
# Comma-separated list of origins allowed to call this API with cookies —
# your Vercel production domain (and preview domains if you want those to
# work too). Not needed for local dev (defaults to http://localhost:5173).
FRONTEND_ORIGIN=

# Set to "production" on Render — flips session cookies to
# SameSite=None; Secure, required for the frontend (Vercel) and this API
# (Render) being on different domains. Leave unset locally.
NODE_ENV=

API_PORT=4000
