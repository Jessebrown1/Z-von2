# Paystack public key — safe to expose in the browser bundle. This must be
# the PUBLIC key (starts with pk_test_/pk_live_), never the secret key
# (sk_...) — that one belongs only in server/.env, never here.
# Get it from https://dashboard.paystack.com/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "Sign in with Google" — from Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID (Web application type). Add
# http://localhost:5173 as an authorized JavaScript origin. Safe to expose
# in the browser — server/.env needs the same value in GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
